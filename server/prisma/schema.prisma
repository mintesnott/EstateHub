// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
  CLIENT
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CLIENT)

  sessionVersion  Int      @default(0)


  passwordChangedAt  DateTime @default(now())
  mustChangePassword Boolean @default(false)
  phone         String?
  profileImage  String?
  agentProfile  AgentProfile?
  clientProfile ClientProfile?
  properties    Property[]
  favorites     Favorite[]
  inquiries     Inquiry[]
  messages      Message[]
  //clientConversations Conversation[] @relation("ClientConversations")
  //agentConversations  Conversation[] @relation("AgentConversations")
  //sentMessages        Message[]
  //viewings            Viewing[]
  //transactions        Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  licenseNumber   String  @unique
  agencyName      String?
  bio             String?
  experienceYears Int     @default(0)

  specializations Json?

  officeAddress  String?
  city           String?
  stateRegion    String?
  websiteUrl     String?
  linkedinUrl    String?
  whatsappNumber String?

  ratingAvg      Decimal  @default(0.00) @db.Decimal(3, 2)
  totalReviews   Int      @default(0)
  commissionRate Decimal? @db.Decimal(4, 2)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  CONDO
  COMMERCIAL
  LAND
}

model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique

  preferredCity       String?
  preferredType       PropertyType?
  maxBudget           Decimal?      @db.Decimal(14, 2)
  minBedrooms         Int?
  minBathrooms        Int?
  preApprovedMortgage Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum PricePeriod {
  MONTHLY
  YEARLY
  TOTAL
}

enum FurnishedStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  SOLD
  RENTED
  INACTIVE
}

model Property {
  id      String @id @default(uuid())
  agentId String

  title        String
  description  String
  propertyType PropertyType
  listingType  ListingType
  price        Decimal      @db.Decimal(14, 2)
  pricePeriod  PricePeriod

  bedrooms  Int?
  bathrooms Int?
  area      Decimal? @db.Decimal(12, 2)

  parkingSpaces Int?
  garageSpaces  Int?

  furnishedStatus FurnishedStatus

  features Json?

  address String?
  city    String
  region  String?
  zipCode String?

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  virtualTourUrl String?

  viewCount  Int     @default(0)
  isFeatured Boolean @default(false)

  availableFrom DateTime?
  yearBuilt     Int?

  status PropertyStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     User            @relation(fields: [agentId], references: [id])
  images    PropertyImage[]
  favorites Favorite[]
  inquiries Inquiry[]
  //conversations Conversation[]
  //viewings      Viewing[]
  //transactions  Transaction[]
}

model PropertyImage {
  id         String @id @default(uuid())
  propertyId String

  imageUrl  String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String @id @default(uuid())
  clientId   String
  propertyId String

  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([clientId, propertyId])
}

enum InquiryStatus {
  PENDING
  CANCELED
  RESPONDED
  CLOSED
  BREACHED
}

enum InquiryPurpose {
  BUY
  RENT
}

model Inquiry {
  id         String @id @default(uuid())
  clientId   String
  propertyId String

   // Client's structured request

  purpose              InquiryPurpose @default(BUY)
  budgetMin            Decimal? @db.Decimal(14, 2)
  budgetMax            Decimal? @db.Decimal(14, 2)
  preferredMoveInDate  DateTime?
  minBedrooms          Int?
  minBathrooms         Int?
  preferredLocation    String?
  financingAvailable   Boolean?
  viewingRequested     Boolean @default(false)

// Optional human-readable additional information
  message String?

  status InquiryStatus @default(PENDING)
  responseDeadline  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

 //responseDeadline DateTime?   // add later for the 3-day job
  conversation Conversation?
}

model Conversation {
   id         String @id @default(uuid())
   inquiryId   String   @unique

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   inquiry  Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  
   messages Message[]
 }

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String

  metadata       Json? // optional structured payload for the first client message / agent structured reply later

  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

